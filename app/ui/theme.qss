/* ============================================================
   Music-App · Tema Oscuro Premium — Minimalista
   Paleta:
     fondo-raiz   #0D0F14
     superficie   #13161E  (card/panel)
     superficie2  #1A1E29  (hover, inputs)
     borde        #252A38
     borde-acento #2E3A5C
     texto-prim   #E8EAF0
     texto-sec    #8A90A2
     texto-muted  #4E5568
     acento       #5B8DEF  (azul eléctrico)
     acento-glow  #3D6DD4
     acento-dim   rgba(91,141,239,0.15)
     success      #3ECF8E
     danger       #E05260
     peligro-dim  rgba(224,82,96,0.18)
   ============================================================ */

* {
    outline: 0;
}

QWidget {
    background-color: #0D0F14;
    color: #E8EAF0;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 10pt;
    selection-background-color: rgba(91, 141, 239, 0.25);
    selection-color: #E8EAF0;
}

/* --- Ventana principal ------------------------------------------------- */
QMainWindow {
    background-color: #0D0F14;
}

/* --- Barra de titulo --------------------------------------------------- */
#topbar {
    background-color: #13161E;
    border-bottom: 1px solid #252A38;
}

#topbarTitle {
    color: #5B8DEF;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 2px;
    padding-left: 6px;
}

/* --- Cabeceras de sección ---------------------------------------------- */
#sectionHeader {
    background-color: #13161E;
    border: 1px solid #252A38;
    border-radius: 10px;
}

#sectionHeaderTitle {
    color: #8A90A2;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

/* Etiquetas de titulo externas (p.ej. "NOMBRE BASE") */
#controlLabel {
    color: #8A90A2;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 1px;
}

#sectionHeaderCount {
    color: #5B8DEF;
    font-size: 9pt;
    font-weight: 600;
    background-color: rgba(91, 141, 239, 0.12);
    border: 1px solid rgba(91, 141, 239, 0.30);
    border-radius: 8px;
    padding: 1px 8px;
}

/* Flecha de colapso dentro de la cabecera */
#sectionHeader QToolButton {
    color: #4E5568;
    padding: 4px;
    font-size: 9pt;
}
#sectionHeader QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #8A90A2;
}

/* --- Cards / Panels ---------------------------------------------------- */
#card {
    background-color: #13161E;
    border: 1px solid #252A38;
    border-radius: 12px;
}

#card QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px;
}
#card QScrollBar::handle:vertical {
    background: #252A38;
    border-radius: 3px;
    min-height: 30px;
}
#card QScrollBar::handle:vertical:hover {
    background: #5B8DEF;
}
#card QScrollBar::add-line:vertical,
#card QScrollBar::sub-line:vertical {
    height: 0;
}
#card QScrollBar::add-page:vertical,
#card QScrollBar::sub-page:vertical {
    background: transparent;
}

/* --- Inputs --------------------------------------------------------------- */
QLineEdit#input {
    background-color: #1A1E29;
    border: 1px solid #252A38;
    border-radius: 8px;
    padding: 7px 12px;
    color: #E8EAF0;
}
QLineEdit#input:hover {
    border-color: #2E3A5C;
}
QLineEdit#input:focus {
    border-color: #5B8DEF;
    background-color: #1E2330;
}
QLineEdit#input::placeholder {
    color: #4E5568;
}

/* --- Botones ----------------------------------------------------------- */
QPushButton {
    border-radius: 8px;
    padding: 7px 18px;
    font-weight: 600;
    font-size: 9.5pt;
}

QPushButton#btnPrimary {
    background-color: #5B8DEF;
    color: #FFFFFF;
    border: 1px solid #4A7ADB;
}
QPushButton#btnPrimary:hover {
    background-color: #6B99F5;
    border-color: #5B8DEF;
}
QPushButton#btnPrimary:pressed {
    background-color: #3D6DD4;
    border-color: #3060C0;
}
QPushButton#btnPrimary:disabled {
    background-color: #1A1E29;
    border-color: #252A38;
    color: #4E5568;
}

QPushButton#btnOutline {
    background-color: transparent;
    color: #8A90A2;
    border: 1px solid #252A38;
}
QPushButton#btnOutline:hover {
    background-color: #1A1E29;
    border-color: #5B8DEF;
    color: #E8EAF0;
}
QPushButton#btnOutline:pressed {
    background-color: #252A38;
}

QPushButton#btnDanger {
    background-color: transparent;
    color: #E05260;
    border: 1px solid rgba(224, 82, 96, 0.35);
}
QPushButton#btnDanger:hover {
    background-color: rgba(224, 82, 96, 0.12);
    border-color: #E05260;
    color: #F07080;
}
QPushButton#btnDanger:pressed {
    background-color: rgba(224, 82, 96, 0.22);
}

/* --- ToolButtons ---------------------------------------------------------- */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #4E5568;
    padding: 4px;
}
QToolButton:hover {
    background-color: #1A1E29;
    color: #8A90A2;
}
QToolButton:pressed {
    background-color: #252A38;
}
QToolButton#btnAccent {
    color: #5B8DEF;
    font-size: 9.5pt;
}
QToolButton#btnAccent:hover {
    background-color: rgba(91, 141, 239, 0.12);
    color: #7AAAF5;
}
QToolButton::menu-indicator {
    image: none;
}

/* --- Tablas y árboles de archivos --------------------------------------- */
QTreeView,
QTableView,
QListView {
    background-color: #13161E;
    alternate-background-color: #161A24;
    border: none;
    border-top: 1px solid #252A38;
    show-decoration-selected: 1;
    gridline-color: transparent;
}

QTreeView::item,
QTableView::item,
QListView::item {
    padding: 6px 8px;
    color: #E8EAF0;
    border-radius: 4px;
    margin: 1px 3px;
}
QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover {
    background-color: #1A1E29;
    color: #E8EAF0;
}
QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected {
    background-color: rgba(91, 141, 239, 0.20);
    color: #C8D8FF;
}

/* Filas de carpetas */
#treeFolders::item {
    font-weight: 500;
    color: #B0B8CC;
}
#treeFolders::item:hover {
    color: #E8EAF0;
}

/* Encabezados de columna */
QHeaderView::section {
    background-color: #13161E;
    color: #4E5568;
    border: none;
    border-bottom: 1px solid #252A38;
    border-right: 1px solid #1A1E29;
    padding: 8px 10px;
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}
QHeaderView::section:hover {
    color: #8A90A2;
    background-color: #1A1E29;
}
QHeaderView::section:checked {
    color: #5B8DEF;
}
QHeaderView::down-arrow,
QHeaderView::up-arrow {
    image: none;
    width: 0;
}
QHeaderView {
    background-color: #13161E;
}

QTreeView::branch {
    background-color: transparent;
}

/* Scrollbars globales */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #252A38;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #5B8DEF;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #252A38;
    border-radius: 3px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #5B8DEF;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- Splitter ---------------------------------------------------------- */
QSplitter::handle {
    background-color: #252A38;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* --- Labels ------------------------------------------------------------ */
#mutedLabel {
    color: #4E5568;
    font-size: 9pt;
}
#secondaryLabel {
    color: #4E5568;
    font-size: 9pt;
}
#countBadge {
    background-color: rgba(91, 141, 239, 0.12);
    border: 1px solid rgba(91, 141, 239, 0.30);
    border-radius: 10px;
    color: #5B8DEF;
    padding: 2px 10px;
    font-size: 9pt;
    font-weight: 600;
}

/* --- Barra de control central ----------------------------------------- */
#controlBar {
    background-color: #0D0F14;
}

/* --- Progreso / Slider (modal multimedia) ------------------------------- */
QProgressBar {
    background-color: #1A1E29;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #5B8DEF;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #252A38;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #5B8DEF;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #7AAAF5;
}
QSlider::sub-page:horizontal {
    background: #5B8DEF;
    border-radius: 2px;
}

/* --- Modales / menus / tooltips --------------------------------------- */
QDialog {
    background-color: #13161E;
}

QMenu {
    background-color: #1A1E29;
    border: 1px solid #252A38;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 20px;
    border-radius: 6px;
    color: #B0B8CC;
    font-size: 9.5pt;
}
QMenu::item:selected {
    background-color: rgba(91, 141, 239, 0.15);
    color: #E8EAF0;
}
QMenu::separator {
    height: 1px;
    background: #252A38;
    margin: 5px 10px;
}

QToolTip {
    background-color: #1A1E29;
    color: #B0B8CC;
    border: 1px solid #252A38;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 9pt;
}

QMessageBox {
    background-color: #13161E;
}
QMessageBox QLabel {
    color: #B0B8CC;
}
QMessageBox QPushButton {
    background-color: #1A1E29;
    border: 1px solid #252A38;
    color: #B0B8CC;
    padding: 6px 16px;
    border-radius: 7px;
}
QMessageBox QPushButton:hover {
    background-color: #252A38;
    border-color: #5B8DEF;
    color: #E8EAF0;
}

QListWidget {
    background-color: #1A1E29;
    border: 1px solid #252A38;
    border-radius: 8px;
}
QListWidget::item {
    padding: 5px 8px;
    color: #8A90A2;
    font-size: 9pt;
}
QListWidget::item:selected {
    background-color: rgba(91, 141, 239, 0.20);
    color: #E8EAF0;
}

QDialogButtonBox QPushButton {
    background-color: #1A1E29;
    border: 1px solid #252A38;
    color: #8A90A2;
    padding: 7px 20px;
    border-radius: 8px;
    font-weight: 600;
}
QDialogButtonBox QPushButton:hover {
    background-color: #252A38;
    border-color: #5B8DEF;
    color: #E8EAF0;
}
QDialogButtonBox QPushButton:default {
    background-color: #5B8DEF;
    border-color: #4A7ADB;
    color: #FFFFFF;
}
QDialogButtonBox QPushButton:default:hover {
    background-color: #6B99F5;
}

/* --- Statusbar --------------------------------------------------------- */
#statusBar {
    background-color: #0D0F14;
    border-top: 1px solid #1A1E29;
}
#statusBarLabel {
    color: #4E5568;
    font-size: 8.5pt;
}
QStatusBar {
    background-color: #0D0F14;
    color: #4E5568;
    font-size: 8.5pt;
    border-top: 1px solid #1A1E29;
}