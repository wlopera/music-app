/* ============================================================
   Music-App · Tema Claro Moderno & Minimalista (Light Mode)
   Paleta:
     fondo-raiz   #F8FAFC  (Gris azulado ultralimpio para todo el marco)
     superficie   #FFFFFF  (Fondo blanco puro para tarjetas y cabeceras)
     borde        #E2E8F0  (Líneas finas y sutiles)
     texto-prim   #0F172A  (Texto oscuro de alta legibilidad)
     texto-sec    #475569  (Gris pizarra para datos secundarios)
     acento       #2563EB  (Azul eléctrico moderno para botones y acentos)
     danger       #EF4444  (Rojo vibrante para alertas)
   ============================================================ */

* {
    outline: 0;
}

QWidget {
    background-color: #F8FAFC; 
    color: #0F172A; 
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 10pt;
    selection-background-color: rgba(37, 99, 235, 0.15);
    selection-color: #0F172A;
}

/* --- Ventana principal ------------------------------------------------- */
QMainWindow {
    background-color: #F8FAFC;
}

/* --- Barra de titulo --------------------------------------------------- */
#topbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

#topbarTitle {
    color: #2563EB; 
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 2px;
    padding-left: 6px;
}

/* --- Cabeceras de sección Claras ---------------------------------------- */
#sectionHeader {
    background-color: #FFFFFF; 
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

#sectionHeaderTitle {
    color: #0F172A; 
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

/* Etiquetas de titulo externas (p.ej. "NOMBRE BASE") */
#controlLabel {
    color: #0F172A;
    font-size: 9.5pt;
    font-weight: 700;
    letter-spacing: 1px;
}

#sectionHeaderCount {
    color: #2563EB;
    font-size: 9pt;
    font-weight: 600;
    background-color: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.20);
    border-radius: 8px;
    padding: 1px 8px;
}

/* Flecha de colapso dentro de la cabecera */
#sectionHeader QToolButton {
    color: #475569;
    padding: 4px;
    font-size: 9pt;
}
#sectionHeader QToolButton:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

/* --- Cards / Panels ---------------------------------------------------- */
#card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

#card QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px;
}
#card QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 3px;
    min-height: 30px;
}
#card QScrollBar::handle:vertical:hover {
    background: #2563EB;
}
#card QScrollBar::add-line:vertical,
#card QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Inputs Claros -------------------------------------------------------- */
QLineEdit, QLineEdit#input {
    background-color: #FFFFFF !important;
    border: 1px solid #CBD5E1 !important;
    border-radius: 6px !important;
    padding: 7px 12px !important;
    color: #0F172A !important;
}
QLineEdit:hover, QLineEdit#input:hover {
    border-color: #94A3B8 !important;
}
QLineEdit:focus, QLineEdit#input:focus {
    border-color: #2563EB !important;
    background-color: #FFFFFF !important;
}
QLineEdit::placeholder {
    color: #94A3B8 !important; 
}
/* --- Botones Estilizados Claros ----------------------------------------- */
QPushButton {
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
    font-size: 9.5pt;
}

QPushButton#btnPrimary {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
}
QPushButton#btnPrimary:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}
QPushButton#btnPrimary:pressed {
    background-color: #1E40AF;
    border-color: #1E40AF;
}
QPushButton#btnPrimary:disabled {
    background-color: #F1F5F9;
    border-color: #E2E8F0;
    color: #94A3B8;
}

QPushButton#btnOutline {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #CBD5E1;
}
QPushButton#btnOutline:hover {
    background-color: #F8FAFC;
    border-color: #2563EB;
    color: #0F172A;
}

QPushButton#btnDanger {
    background-color: transparent;
    color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.45);
}
QPushButton#btnDanger:hover {
    background-color: #FEF2F2;
    border-color: #EF4444;
}

/* --- ToolButtons internos (#card) ---------------------------------------- */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #475569;
    padding: 4px;
}
QToolButton:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

/* Ajusta los botones internos como "Copiar" */
#card QToolButton, #card QPushButton {
    background-color: #F1F5F9 !important;
    color: #475569 !important;
    border: 1px solid #CBD5E1 !important;
}
#card QToolButton:hover, #card QPushButton:hover {
    background-color: #2563EB !important;
    color: #FFFFFF !important;
}

/* --- Tablas y Árboles Claros --------------------------------------------- */
QTreeView,
QTableView,
QListView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: none;
    border-top: 1px solid #E2E8F0;
    show-decoration-selected: 1;
    gridline-color: transparent;
}

QTreeView::item,
QTableView::item,
QListView::item {
    padding: 6px 8px;
    color: #0F172A;
    border-radius: 4px;
    margin: 1px 3px;
}
QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}
QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected {
    background-color: #E0F2FE;
    color: #0284C7;
    font-weight: 600;
}

#treeFolders::item {
    font-weight: 600;
    color: #334155;
}
#treeFolders::item:hover {
    color: #0F172A;
}

/* --- Encabezados de Columna (Márgenes de seguridad) ----------------------- */
QHeaderView::section {
    background-color: #F1F5F9;
    color: #475569;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #E2E8F0;
    padding: 8px 16px;
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    text-align: left;
}
QHeaderView::section:hover {
    color: #0F172A;
    background-color: #E2E8F0;
}
QHeaderView::section:checked {
    color: #2563EB;
}
QHeaderView {
    background-color: #F1F5F9;
}

QTreeView::branch {
    background-color: transparent;
}

/* Scrollbars globales */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #2563EB;
}

/* --- Splitter Horizontal y Vertical Limpios ---------------------------- */
QSplitter::handle {
    background-color: #E2E8F0; /* Línea gris fina sutil */
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}
/* --- Labels ------------------------------------------------------------ */
#mutedLabel, #secondaryLabel {
    color: #64748B;
    font-size: 9pt;
}
#countBadge {
    background-color: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.20);
    border-radius: 10px;
    color: #2563EB;
    padding: 2px 10px;
    font-size: 9pt;
    font-weight: 600;
}

/* --- Barra de control central ----------------------------------------- */
#controlBar {
    background-color: #F8FAFC;
}

/* --- Progreso / Slider (modal multimedia) ------------------------------- */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #E2E8F0;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #2563EB;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #1D4ED8;
}
QSlider::sub-page:horizontal {
    background: #2563EB;
    border-radius: 2px;
}

/* --- Modales / Menus / Tooltips Claras --------------------------------- */
QDialog {
    background-color: #FFFFFF;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 20px;
    border-radius: 6px;
    color: #0F172A;
    font-size: 9.5pt;
}
QMenu::item:selected {
    background-color: rgba(37, 99, 235, 0.08);
    color: #2563EB;
}
QMenu::separator {
    height: 1px;
    background: #E2E8F0;
    margin: 5px 10px;
}

QToolTip {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 9pt;
}

QMessageBox {
    background-color: #FFFFFF;
}
QMessageBox QLabel {
    color: #0F172A;
}
QMessageBox QPushButton {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    color: #0F172A;
    padding: 6px 16px;
    border-radius: 7px;
}
QMessageBox QPushButton:hover {
    background-color: #E2E8F0;
    border-color: #2563EB;
}

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}
QListWidget::item {
    padding: 5px 8px;
    color: #475569;
    font-size: 9pt;
}
QListWidget::item:selected {
    background-color: rgba(37, 99, 235, 0.12);
    color: #2563EB;
}

QDialogButtonBox QPushButton {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    color: #475569;
    padding: 7px 20px;
    border-radius: 8px;
    font-weight: 600;
}
QDialogButtonBox QPushButton:hover {
    background-color: #E2E8F0;
    border-color: #2563EB;
    color: #0F172A;
}
QDialogButtonBox QPushButton:default {
    background-color: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
}

/* --- Statusbar --------------------------------------------------------- */
#statusBar {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
}
#statusBarLabel {
    color: #475569;
    font-size: 8.5pt;
}
QStatusBar {
    background-color: #F8FAFC;
    color: #475569;
    font-size: 8.5pt;
    border-top: 1px solid #E2E8F0;
}
