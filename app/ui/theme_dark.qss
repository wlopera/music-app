/* ============================================================
   Music-App · Tema Oscuro Moderno & Minimalista (Dark Mode)
   Paleta:
     fondo-raiz   #0B1220  (Azul muy oscuro para todo el marco)
     superficie   #111827  (Paneles, tarjetas y cabeceras)
     borde        #1F2937  (Lineas finas y sutiles)
     texto-prim   #E5E7EB  (Texto claro de alta legibilidad)
     texto-sec    #9CA3AF  (Gris medio para datos secundarios)
     acento       #3B82F6  (Azul moderno para botones y acentos)
     danger       #F87171  (Rojo suave para alertas)
   ============================================================ */

* {
    outline: 0;
}

QWidget {
    background-color: #0B1220;
    color: #E5E7EB;
    font-family: "Segoe UI Variable Text", "Segoe UI", sans-serif;
    font-size: 10pt;
    selection-background-color: rgba(59, 130, 246, 0.28);
    selection-color: #F9FAFB;
}

/* --- Ventana principal ------------------------------------------------- */
QMainWindow {
    background-color: #0B1220;
}

/* --- Barra de titulo --------------------------------------------------- */
#topbar {
    background-color: #111827;
    border-bottom: 1px solid #1F2937;
}

#topbarTitle {
    color: #60A5FA;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 2px;
    padding-left: 6px;
}

/* --- Cabeceras de seccion oscuras -------------------------------------- */
#sectionHeader {
    background-color: #111827;
    border: 1px solid #1F2937;
    border-radius: 8px;
}

#sectionHeaderTitle {
    color: #E5E7EB;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

/* Etiquetas de titulo externas (p.ej. "NOMBRE BASE") */
#controlLabel {
    color: #E5E7EB;
    font-size: 9.5pt;
    font-weight: 700;
    letter-spacing: 1px;
}

#sectionHeaderCount {
    color: #60A5FA;
    font-size: 9pt;
    font-weight: 600;
    background-color: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 8px;
    padding: 1px 8px;
}

/* Flecha de colapso dentro de la cabecera */
#sectionHeader QToolButton {
    color: #9CA3AF;
    padding: 4px;
    font-size: 9pt;
}
#sectionHeader QToolButton:hover {
    background-color: #1F2937;
    color: #E5E7EB;
}

/* --- Cards / Panels ---------------------------------------------------- */
#card {
    background-color: #111827;
    border: 1px solid #1F2937;
    border-radius: 10px;
}

#card QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 2px;
}
#card QScrollBar::handle:vertical {
    background: #374151;
    border-radius: 3px;
    min-height: 30px;
}
#card QScrollBar::handle:vertical:hover {
    background: #3B82F6;
}
#card QScrollBar::add-line:vertical,
#card QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Inputs oscuros -------------------------------------------------------- */
QLineEdit, QLineEdit#input {
    background-color: #0B1220 !important;
    border: 1px solid #374151 !important;
    border-radius: 6px !important;
    padding: 7px 12px !important;
    color: #E5E7EB !important;
}
QLineEdit:hover, QLineEdit#input:hover {
    border-color: #4B5563 !important;
}
QLineEdit:focus, QLineEdit#input:focus {
    border-color: #3B82F6 !important;
    background-color: #0B1220 !important;
}
QLineEdit::placeholder {
    color: #6B7280 !important;
}

/* --- Botones Estilizados Oscuros ----------------------------------------- */
QPushButton {
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
    font-size: 9.5pt;
}

QPushButton#btnPrimary {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: 1px solid #3B82F6;
}
QPushButton#btnPrimary:hover {
    background-color: #2563EB;
    border-color: #2563EB;
}
QPushButton#btnPrimary:pressed {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}
QPushButton#btnPrimary:disabled {
    background-color: #1F2937;
    border-color: #374151;
    color: #6B7280;
}

QPushButton#btnOutline {
    background-color: #111827;
    color: #9CA3AF;
    border: 1px solid #374151;
}
QPushButton#btnOutline:hover {
    background-color: #1F2937;
    border-color: #3B82F6;
    color: #E5E7EB;
}

QPushButton#btnDanger {
    background-color: transparent;
    color: #F87171;
    border: 1px solid rgba(248, 113, 113, 0.45);
}
QPushButton#btnDanger:hover {
    background-color: rgba(248, 113, 113, 0.10);
    border-color: #F87171;
}

QPushButton#btnAccent {
    background-color: rgba(59, 130, 246, 0.16);
    color: #60A5FA;
    border: 1px solid rgba(59, 130, 246, 0.40);
}
QPushButton#btnAccent:hover {
    background-color: rgba(59, 130, 246, 0.28);
    border-color: #3B82F6;
}

/* --- ToolButtons internos (#card) ---------------------------------------- */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #9CA3AF;
    padding: 4px;
}
QToolButton:hover {
    background-color: #1F2937;
    color: #E5E7EB;
}

/* Ajusta los botones internos como "Copiar" */
#card QToolButton, #card QPushButton {
    background-color: #1F2937 !important;
    color: #9CA3AF !important;
    border: 1px solid #374151 !important;
}
#card QToolButton:hover, #card QPushButton:hover {
    background-color: #3B82F6 !important;
    color: #FFFFFF !important;
}

/* --- Tablas y Arboles Oscuros --------------------------------------------- */
QTreeView,
QTableView,
QListView {
    background-color: #111827;
    alternate-background-color: #0F172A;
    border: none;
    border-top: 1px solid #1F2937;
    show-decoration-selected: 1;
    gridline-color: transparent;
}

QTreeView::item,
QTableView::item,
QListView::item {
    padding: 6px 8px;
    color: #E5E7EB;
    border-radius: 4px;
    margin: 1px 3px;
}
QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover {
    background-color: #1F2937;
    color: #F9FAFB;
}
QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected {
    background-color: rgba(59, 130, 246, 0.28);
    color: #93C5FD;
    font-weight: 600;
}

#treeFolders::item {
    font-weight: 600;
    color: #D1D5DB;
}
#treeFolders::item:hover {
    color: #F9FAFB;
}

/* --- Encabezados de Columna ---------------------------------------------- */
QHeaderView::section {
    background-color: #1F2937;
    color: #9CA3AF;
    border: none;
    border-bottom: 1px solid #374151;
    border-right: 1px solid #374151;
    padding: 8px 16px;
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    text-align: left;
}
QHeaderView::section:hover {
    color: #E5E7EB;
    background-color: #374151;
}
QHeaderView::section:checked {
    color: #60A5FA;
}
QHeaderView {
    background-color: #1F2937;
}

QTreeView::branch {
    background-color: transparent;
}

/* Scrollbars globales */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #374151;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #3B82F6;
}

/* --- Splitter Horizontal y Vertical --------------------------------------- */
QSplitter::handle {
    background-color: #1F2937;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* --- Labels ------------------------------------------------------------ */
#mutedLabel, #secondaryLabel {
    color: #9CA3AF;
    font-size: 9pt;
}
#countBadge {
    background-color: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 10px;
    color: #60A5FA;
    padding: 2px 10px;
    font-size: 9pt;
    font-weight: 600;
}

/* --- Barra de control central ----------------------------------------- */
#controlBar {
    background-color: #0B1220;
}

/* --- Progreso / Slider ------------------------------------------------- */
QProgressBar {
    background-color: #1F2937;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #3B82F6;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #1F2937;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #3B82F6;
    border: none;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #60A5FA;
}
QSlider::sub-page:horizontal {
    background: #3B82F6;
    border-radius: 2px;
}

/* --- Modales / Menus / Tooltips Oscuras --------------------------------- */
QDialog {
    background-color: #111827;
}

QMenu {
    background-color: #111827;
    border: 1px solid #374151;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 20px;
    border-radius: 6px;
    color: #E5E7EB;
    font-size: 9.5pt;
}
QMenu::item:selected {
    background-color: rgba(59, 130, 246, 0.18);
    color: #60A5FA;
}
QMenu::separator {
    height: 1px;
    background: #1F2937;
    margin: 5px 10px;
}

QToolTip {
    background-color: #1F2937;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 9pt;
}

QMessageBox {
    background-color: #111827;
}
QMessageBox QLabel {
    color: #E5E7EB;
}
QMessageBox QPushButton {
    background-color: #1F2937;
    border: 1px solid #374151;
    color: #E5E7EB;
    padding: 6px 16px;
    border-radius: 7px;
}
QMessageBox QPushButton:hover {
    background-color: #374151;
    border-color: #3B82F6;
}

QListWidget {
    background-color: #111827;
    border: 1px solid #1F2937;
    border-radius: 8px;
}
QListWidget::item {
    padding: 5px 8px;
    color: #9CA3AF;
    font-size: 9pt;
}
QListWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.20);
    color: #60A5FA;
}

QDialogButtonBox QPushButton {
    background-color: #1F2937;
    border: 1px solid #374151;
    color: #9CA3AF;
    padding: 7px 20px;
    border-radius: 8px;
    font-weight: 600;
}
QDialogButtonBox QPushButton:hover {
    background-color: #374151;
    border-color: #3B82F6;
    color: #E5E7EB;
}
QDialogButtonBox QPushButton:default {
    background-color: #3B82F6;
    border-color: #3B82F6;
    color: #FFFFFF;
}

/* --- Statusbar --------------------------------------------------------- */
#statusBar {
    background-color: #111827;
    border-top: 1px solid #1F2937;
}
#statusBarLabel {
    color: #9CA3AF;
    font-size: 8.5pt;
}
QStatusBar {
    background-color: #111827;
    color: #9CA3AF;
    font-size: 8.5pt;
    border-top: 1px solid #1F2937;
}
QToolButton#btnIconHeader {
    background-color: #1F2937;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 4px;
}
QToolButton#btnIconHeader:hover {
    background-color: #374151;
    border-color: #4B5563;
}

/* --- Bienvenida -------------------------------------------------------- */
#welcomeCardTitle {
    color: #60A5FA;
    font-size: 10pt;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}
#welcomeBody {
    color: #9CA3AF;
    font-size: 9.5pt;
}
#welcomeFooter {
    color: #6B7280;
    font-size: 9pt;
}

/* ============================================================
   Shell de ventana: cabecera + menú lateral + pie (sidebar navigation)
   ============================================================ */

#centralRoot {
    background-color: #0B1220;
}

/* --- Cabecera (titlebar manual: arrastrable, doble clic = maximizar) ---- */
#windowHeader {
    background-color: #111827;
    border-bottom: 1px solid #1F2937;
}
#headerMark {
    font-size: 13pt;
    padding-right: 2px;
}
#headerTitle {
    color: #E5E7EB;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 0.5px;
}
QToolButton#headerButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #9CA3AF;
    padding: 6px;
}
QToolButton#headerButton:hover {
    background-color: #1F2937;
    color: #E5E7EB;
}
QToolButton#btnWinMin, QToolButton#btnWinMax {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #9CA3AF;
    font-size: 11pt;
}
QToolButton#btnWinMin:hover, QToolButton#btnWinMax:hover {
    background-color: #1F2937;
    color: #E5E7EB;
}
QToolButton#btnWinClose {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #9CA3AF;
    font-size: 10pt;
}
QToolButton#btnWinClose:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

/* --- Menú lateral ------------------------------------------------------ */
#sidebar {
    background-color: #111827;
    border-right: 1px solid #1F2937;
}
#sidebarHeading {
    color: #6B7280;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 2px;
    padding-left: 8px;
}
QPushButton#navItem {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #9CA3AF;
    font-size: 10pt;
    text-align: left;
    padding: 11px 12px;
}
QPushButton#navItem:hover {
    background-color: #1F2937;
    color: #E5E7EB;
}
QPushButton#navItem:checked {
    background-color: rgba(59, 130, 246, 0.18);
    color: #60A5FA;
    font-weight: 600;
}

/* --- Pie: estado + firma ----------------------------------------------- */
#windowFooter {
    background-color: #111827;
    border-top: 1px solid #1F2937;
}
#footerStatus {
    color: #9CA3AF;
    font-size: 8.5pt;
}

/* --- Textos de bienvenida / placeholder -------------------------------- */
#welcomeHint {
    color: #94A3AF;
    font-size: 9.5pt;
    padding: 4px 0;
}
